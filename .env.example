# Supabase — get these from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin auth
ADMIN_PASSWORD=choose-a-strong-password      # admin portal + counter tool
STAFF_PASSWORD=choose-a-different-password   # counter tool only
# SESSION_SECRET: random 32-byte hex string used to sign session cookies
# Generate with: openssl rand -hex 32
SESSION_SECRET=generate-with-openssl-rand-hex-32

# App URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
